# RISKWISE Environment Configuration
# Copy this file to .env and update values as needed

# Backend
DATABASE_URL=sqlite:///./riskwise.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api/v1

# Optional: LLM Integration (not required for core functionality)
# GEMINI_API_KEY=your-api-key-here

# Application
APP_NAME=RISKWISE
APP_VERSION=1.0.0
DEBUG=true
